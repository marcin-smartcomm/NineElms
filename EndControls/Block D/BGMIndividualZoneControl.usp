#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#symbol_name "BGM Individual Vol Control"
#output_shift 0      
                     
string_parameter roomIdentifier[10];
           
analog_input _skip_, zone1_Vol_Fb#, zone2_Vol_Fb#, zone3_Vol_Fb#, zone4_Vol_Fb#;  
string_input Rx$[100];

analog_output _skip_, zone1_volume#, zone2_volume#, zone3_volume#, zone4_volume#;
string_output Tx$;

change Rx$
{
	if(left(Rx$, 3) = "BGM")
	{
		if(find(roomIdentifier, Rx$) > 0)
		{
	     	if(mid(Rx$, 12, 5) = "Zone1")
			{
	         	zone1_volume# = atoi(mid(Rx$, 18, 3));
			}
	     	if(mid(Rx$, 12, 5) = "Zone2")
			{
	         	zone2_volume# = atoi(mid(Rx$, 18, 3));
			}

	     	if(mid(Rx$, 12, 5) = "Zone3")
			{
	         	zone3_volume# = atoi(mid(Rx$, 18, 3));
			}

	     	if(mid(Rx$, 12, 5) = "Zone4")
			{
	         	zone4_volume# = atoi(mid(Rx$, 18, 3));
			}
		}
	}
}

change zone1_Vol_Fb#
{
	Tx$ = "BGM:"+roomIdentifier+":Zone1Volume:" + itoa(zone1_Vol_Fb#); 	
}

change zone2_Vol_Fb#
{
	Tx$ = "BGM:"+roomIdentifier+":Zone2Volume:" + itoa(zone2_Vol_Fb#); 	
}


change zone3_Vol_Fb#
{
	Tx$ = "BGM:"+roomIdentifier+":Zone3Volume:" + itoa(zone3_Vol_Fb#); 	
}


change zone4_Vol_Fb#
{
	Tx$ = "BGM:"+roomIdentifier+":Zone4Volume:" + itoa(zone4_Vol_Fb#); 	
}

